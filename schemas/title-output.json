{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  },
  "required": ["title", "description"]
}
